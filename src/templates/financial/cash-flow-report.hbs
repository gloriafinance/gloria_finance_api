<html lang="{{i18nLang}}">
  <head>
    <meta charset="UTF-8" />
    <title>{{t "cash_flow_report.title"}}</title>
    <style>
      :root {
        color-scheme: light;
      }

      body {
        font-family: Arial, sans-serif;
        margin: 24px;
        color: #1f2937;
      }

      h1,
      h2 {
        margin: 0 0 8px;
        color: #0f172a;
      }

      h1 {
        font-size: 24px;
      }

      h2 {
        margin-top: 28px;
        font-size: 16px;
      }

      .meta p,
      .messages p {
        margin: 4px 0;
        font-size: 12px;
      }

      .summary-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(120px, 1fr));
        gap: 12px;
        margin: 20px 0 12px;
      }

      .card {
        border: 1px solid #dbe3ea;
        border-radius: 8px;
        padding: 12px;
        background: #f8fafc;
      }

      .card .label {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 6px;
      }

      .card .value {
        font-size: 16px;
        font-weight: 700;
      }

      .projection-box {
        margin-top: 20px;
        padding: 16px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background: #eff6ff;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        margin-top: 12px;
      }

      th,
      td {
        border: 1px solid #dbe3ea;
        padding: 8px;
        text-align: left;
      }

      th {
        background: #e2e8f0;
        text-transform: uppercase;
        font-size: 11px;
        color: #334155;
      }

      .number {
        text-align: right;
      }

      .empty {
        text-align: center;
        color: #64748b;
        padding: 24px;
      }
    </style>
  </head>
  <body>
    <h1>{{t "cash_flow_report.title"}}</h1>

    <div class="meta">
      <p>
        <strong>{{t "cash_flow_report.church_label"}}</strong>
        {{#if church}}
          {{church}}
        {{else}}
          {{t "cash_flow_report.church_not_informed"}}
        {{/if}}
      </p>
      <p>
        <strong>{{t "cash_flow_report.generated_at"}}</strong>
        {{formatDate generatedAt}}
      </p>
      <p>
        <strong>{{t "cash_flow_report.period_label"}}</strong>
        {{formatDate filters.startDate}}
        -
        {{formatDate filters.endDate}}
      </p>
      <p>
        <strong>{{t "cash_flow_report.group_by"}}</strong>
        {{filters.groupByLabel}}
      </p>
      {{#if filters.methodLabel}}
        <p>
          <strong>{{t "cash_flow_report.account_types"}}</strong>
          {{filters.methodLabel}}
        </p>
      {{/if}}
      {{#if filters.symbol}}
        <p>
          <strong>{{t "cash_flow_report.primary_currency"}}</strong>
          {{filters.symbol}}
        </p>
      {{/if}}
      {{#if filters.availabilityAccountsLabel}}
        <p>
          <strong>{{t "cash_flow_report.availability_accounts"}}</strong>
          {{filters.availabilityAccountsLabel}}
        </p>
      {{/if}}
      {{#if filters.costCenterId}}
        <p>
          <strong>{{t "cash_flow_report.cost_center"}}</strong>
          {{filters.costCenterId}}
        </p>
      {{/if}}
    </div>

    <div class="summary-grid">
      <div class="card">
        <span class="label">{{t
            "cash_flow_report.summary.opening_balance"
          }}</span>
        <span class="value">{{formatCurrency
            summary.openingBalance
            filters.symbol
          }}</span>
      </div>
      <div class="card">
        <span class="label">{{t "cash_flow_report.summary.entries"}}</span>
        <span class="value">{{formatCurrency
            summary.entries
            filters.symbol
          }}</span>
      </div>
      <div class="card">
        <span class="label">{{t "cash_flow_report.summary.exits"}}</span>
        <span class="value">{{formatCurrency
            summary.exits
            filters.symbol
          }}</span>
      </div>
      <div class="card">
        <span class="label">{{t "cash_flow_report.summary.net"}}</span>
        <span class="value">{{formatCurrency summary.net filters.symbol}}</span>
      </div>
      <div class="card">
        <span class="label">{{t
            "cash_flow_report.summary.closing_balance"
          }}</span>
        <span class="value">{{formatCurrency
            summary.closingBalance
            filters.symbol
          }}</span>
      </div>
    </div>

    {{#if messages.length}}
      <div class="messages">
        {{#each messages}}
          <p>{{this}}</p>
        {{/each}}
      </div>
    {{/if}}

    <h2>{{t "cash_flow_report.realized_series_title"}}</h2>
    <table>
      <thead>
        <tr>
          <th>{{t "cash_flow_report.table.period"}}</th>
          <th class="number">{{t "cash_flow_report.table.entries"}}</th>
          <th class="number">{{t "cash_flow_report.table.exits"}}</th>
          <th class="number">{{t "cash_flow_report.table.net"}}</th>
          <th class="number">{{t "cash_flow_report.table.running_balance"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#if series.length}}
          {{#each series}}
            <tr>
              <td>{{formatDate period}}</td>
              <td class="number">{{formatCurrency
                  entries
                  @root.filters.symbol
                }}</td>
              <td class="number">{{formatCurrency
                  exits
                  @root.filters.symbol
                }}</td>
              <td class="number">{{formatCurrency
                  net
                  @root.filters.symbol
                }}</td>
              <td class="number">{{formatCurrency
                  runningBalance
                  @root.filters.symbol
                }}</td>
            </tr>
          {{/each}}
        {{else}}
          <tr>
            <td class="empty" colspan="5">{{t "cash_flow_report.empty"}}</td>
          </tr>
        {{/if}}
      </tbody>
    </table>

    {{#if filters.includeProjection}}
      <div class="projection-box">
        <h2>{{t "cash_flow_report.projection.title"}}</h2>
        <p>
          <strong>{{t "cash_flow_report.projection.status_label"}}</strong>
          {{projection.statusLabel}}
        </p>
        {{#if projection.message}}
          <p>{{projection.message}}</p>
        {{/if}}
        <p>{{t "cash_flow_report.projection.disclaimer"}}</p>

        <table>
          <thead>
            <tr>
              <th>{{t "cash_flow_report.table.period"}}</th>
              <th class="number">{{t
                  "cash_flow_report.projection.entries"
                }}</th>
              <th class="number">{{t "cash_flow_report.projection.exits"}}</th>
              <th class="number">{{t "cash_flow_report.projection.net"}}</th>
              <th class="number">{{t
                  "cash_flow_report.projection.balance"
                }}</th>
            </tr>
          </thead>
          <tbody>
            {{#if projection.buckets.length}}
              {{#each projection.buckets}}
                <tr>
                  <td>{{formatDate period}}</td>
                  <td class="number">{{formatCurrency
                      projectedEntries
                      @root.filters.symbol
                    }}</td>
                  <td class="number">{{formatCurrency
                      projectedExits
                      @root.filters.symbol
                    }}</td>
                  <td class="number">{{formatCurrency
                      projectedNet
                      @root.filters.symbol
                    }}</td>
                  <td class="number">{{formatCurrency
                      projectedBalance
                      @root.filters.symbol
                    }}</td>
                </tr>
              {{/each}}
            {{else}}
              <tr>
                <td class="empty" colspan="5">{{t
                    "cash_flow_report.projection.empty"
                  }}</td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    {{/if}}
  </body>
</html>