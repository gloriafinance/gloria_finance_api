{
  "name": "church_financial_api",
  "version": "2.19.0",
  "description": "API Church Financial System",
  "main": "dist/app.js",
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "test": "bunx jest --forceExit --runInBand --detectOpenHandles",
    "start:prod": "bun src/app.ts",
    "cli": "bun src/cli.ts",
    "migrate": "set -a && . ./.env && set +a && ts-mongo migrate:up",
    "format": "prettier --write \"src/**/*.{ts,hbs}\" ",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "copy-static-assets": "bun src/copyStaticAssets.ts",
    "jwt:create": "bun run scripts/setup-signing-private-jwt.ts"
  },
  "author": "angel bejarano / angel.bejarano@jaspesoft.com",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jaspesoft/church_financial_api.git"
  },
  "license": "ISC",
  "dependencies": {
    "@abejarano/ts-mongodb-criteria": "^1.11.3",
    "@axiomhq/pino": "^2.0.0",
    "@bull-board/api": "^9.9.0",
    "@bull-board/bun": "^9.9.0",
    "@bull-board/ui": "^9.9.0",
    "@fast-csv/parse": "^5.0.7",
    "@google-cloud/logging": "^12.0.1",
    "@google-cloud/secret-manager": "^7.1.0",
    "@google-cloud/storage": "^8.1.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "bun-platform-kit": "^1.2.0",
    "dayjs": "^1.11.23",
    "firebase-admin": "^14.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "node-input-validator": "^4.6.0",
    "nodemailer": "^10.0.2",
    "nodemailer-express-handlebars": "^7.0.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "puppeteer": "^25.10.0",
    "sharp": "^0.35.4",
    "shelljs": "^0.10.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.4",
    "typescript": "^7.0.2"
  }
}
