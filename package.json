{
  "name": "church_financial_api",
  "version": "2.15.6",
  "description": "API Church Financial System",
  "main": "dist/app.js",
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "test": "bunx jest --forceExit --runInBand --detectOpenHandles",
    "start:prod": "bun src/app.ts",
    "cli": "bun src/cli.ts",
    "migrate": "set -a && . ./.env && set +a && ts-mongo migrate:up",
    "format": "prettier --write \"src/**/*.{ts,hbs}\" ",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "copy-static-assets": "bun src/copyStaticAssets.ts",
    "jwt:create": "bun run scripts/setup-signing-private-jwt.ts"
  },
  "author": "angel bejarano / angel.bejarano@jaspesoft.com",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jaspesoft/church_financial_api.git"
  },
  "license": "ISC",
  "dependencies": {
    "@abejarano/ts-mongodb-criteria": "^1.11.3",
    "@axiomhq/pino": "^1.8.0",
    "@bull-board/api": "^6.21.3",
    "@bull-board/bun": "^6.21.3",
    "@bull-board/ui": "^6.21.3",
    "@fast-csv/parse": "^5.0.7",
    "@google-cloud/logging": "^11.3.0",
    "@google-cloud/secret-manager": "^6.3.0",
    "@google-cloud/storage": "^7.21.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "bun-platform-kit": "^1.2.0",
    "dayjs": "^1.11.21",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "node-input-validator": "^4.6.0",
    "nodemailer": "^7.0.13",
    "nodemailer-express-handlebars": "^7.0.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "puppeteer": "^24.43.1",
    "sharp": "^0.34.4",
    "shelljs": "^0.10.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.9.3"
  }
}
